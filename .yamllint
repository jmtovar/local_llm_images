extends: default

rules:
  # Workflows don't start with "---"
  document-start: disable
  # GitHub Actions uses the bare key "on"
  truthy:
    check-keys: false
  # Action SHAs with version comments and long run lines
  line-length:
    max: 120
  comments:
    min-spaces-from-content: 1
