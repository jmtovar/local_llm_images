Bootstrap: docker
From: debian:trixie-slim

# Generated by: Claude Opus 5.5
# Generation date: 2026-10-10
#
# Bootstrap environment for building local_llm_images with Claude Code.
# OS tools live in the image. Claude Code, its login and your git config
# live in the persistent sandbox home (~/projects/llm-bootstrap/home), so the image
# stays generic and Claude Code can auto-update.

%labels
    Purpose bootstrap environment for local_llm_images

%environment
    export LANG=C.UTF-8
    export EDITOR=vim
    export PATH="$HOME/.local/bin:$PATH"

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends \
        ca-certificates curl git gh vim less ripgrep jq procps \
        openssh-client yamllint shellcheck unzip xz-utils bash-completion
    apt-get clean
    rm -rf /var/lib/apt/lists/*
    # Login shells reset PATH via /etc/profile, so add ~/.local/bin there too
    echo 'export PATH="$HOME/.local/bin:$PATH"' > /etc/profile.d/local-bin.sh

%runscript
    exec /bin/bash -l "$@"
