# Generated by: Claude Opus 5.5
# Generation date: 2026-10-11
#
# CPU-only Ollama on Debian, for unprivileged Singularity/Apptainer use.
# Targets: "base" (models bind-mounted at /models) and "model" (one model baked in).
# Sources for every pinned version and digest: README.md, "Base image".

ARG OLLAMA_VERSION=0.40.2
ARG OLLAMA_IMAGE_DIGEST=sha256:b86366bb528bbf7f1424435d165028497a5b69bf6ddb4fa5a87102e2b79f44fb
ARG DEBIAN_IMAGE=debian:trixie-slim@sha256:a29215f6a35e51e22adffa17f89e9d2ef06214e64a2bad10d765c46aea49f11f

FROM ollama/ollama:${OLLAMA_VERSION}@${OLLAMA_IMAGE_DIGEST} AS ollama
# GPU backends (cuda_v12, cuda_v13, mlx_cuda_v13, vulkan) live in subdirectories;
# the CPU libraries are the top-level files. Drop the subdirectories, then any
# symlink left pointing into them (e.g. "include").
RUN find /usr/lib/ollama -mindepth 1 -maxdepth 1 -type d -exec rm -rf {} + \
 && find /usr/lib/ollama -xtype l -delete

FROM ${DEBIAN_IMAGE} AS runtime
ARG OLLAMA_VERSION
COPY --from=ollama /usr/bin/ollama /usr/bin/ollama
COPY --from=ollama /usr/lib/ollama /usr/lib/ollama
# CA bundle from the pinned upstream image (no unpinned apt install); needed for pulls
COPY --from=ollama /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt

# Privacy and low-resource defaults; override with --env
ENV OLLAMA_HOST=127.0.0.1:11434 \
    OLLAMA_NO_CLOUD=1 \
    OLLAMA_KEEP_ALIVE=30m \
    OLLAMA_MAX_LOADED_MODELS=1 \
    OLLAMA_NUM_PARALLEL=1 \
    OLLAMA_CONTEXT_LENGTH=8192 \
    OLLAMA_FLASH_ATTENTION=1 \
    OLLAMA_KV_CACHE_TYPE=q8_0 \
    OLLAMA_DEBUG=0

LABEL org.opencontainers.image.source="https://github.com/jmtovar/local_llm_images" \
      io.github.jmtovar.local-llm-images.accelerator="cpu" \
      io.github.jmtovar.local-llm-images.arch="amd64" \
      io.github.jmtovar.local-llm-images.ollama.version="${OLLAMA_VERSION}"

ENTRYPOINT ["/usr/bin/ollama"]
CMD ["serve"]

FROM runtime AS base
# Mount point for the bind-mounted model store
RUN mkdir /models
ENV OLLAMA_MODELS=/models

FROM runtime AS model
ARG MODEL
ARG MODEL_DIGEST
ENV OLLAMA_MODELS=/opt/ollama/models
# Pull with a temporary server, then verify the pinned manifest digest.
# Ollama keeps the registry manifest byte-for-byte as blobs/sha256-<digest> and
# rewrites manifests/... to reference it, so check the blob, not the manifest file.
RUN set -eu; \
    test -n "${MODEL}" && test -n "${MODEL_DIGEST}"; \
    export HOME=/tmp/ollama-build; \
    mkdir -p "${HOME}" "${OLLAMA_MODELS}"; \
    ollama serve >/tmp/serve.log 2>&1 & pid=$!; \
    i=0; \
    until ollama list >/dev/null 2>&1; do \
      i=$((i + 1)); \
      if [ "$i" -ge 60 ]; then cat /tmp/serve.log; exit 1; fi; \
      sleep 1; \
    done; \
    ollama pull "${MODEL}" >/tmp/pull.log 2>&1 || { tail -n 20 /tmp/pull.log; exit 1; }; \
    kill "$pid"; wait "$pid" || true; \
    hex="${MODEL_DIGEST#sha256:}"; \
    echo "${hex}  ${OLLAMA_MODELS}/blobs/sha256-${hex}" | sha256sum -c -; \
    grep -rqF "${MODEL_DIGEST}" "${OLLAMA_MODELS}/manifests"; \
    rm -rf "${HOME}" /tmp/serve.log /tmp/pull.log; \
    chmod -R a+rX "${OLLAMA_MODELS}"

LABEL io.github.jmtovar.local-llm-images.model="${MODEL}" \
      io.github.jmtovar.local-llm-images.model.digest="${MODEL_DIGEST}"
